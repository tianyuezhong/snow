{
  "name": "xueji",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test --test-isolation=none src/core.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "prepare:pages": "npm run build && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "tsx": "^4.19.4",
    "fake-indexeddb": "^6.0.0",
    "@types/node": "^22.0.0"
  }
}
